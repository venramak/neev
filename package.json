{
  "name": "neev",
  "private": true,
  "version": "0.1.0",
  "description": "Neev: see who holds you, and reach them. On-device, no accounts.",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p workers/api --noEmit",
